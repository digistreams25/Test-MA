  "schemaElements": [
    {
      "id": "pipe-network-test",
      "name": "PN-Test Pipe Network",
      "c3d": {
        "targets": ["pipe", "structure"],
        "matchAll": [
          { "kind": "networkEquals", "value": "PN-Test" }
        ]
      },
      "schemaElementParameters": [
        {
          "name": "Network_Name",
          "storageType": "text",
          "valueMode": "Rule",
          "mappingRule": "networkName",
          "isRequired": false
        },
        {
          "name": "Part_Family",
          "storageType": "text",
          "valueMode": "Rule",
          "mappingRule": "partFamily",
          "isRequired": false
        },
        {
          "name": "Part_Size",
          "storageType": "text",
          "valueMode": "Rule",
          "mappingRule": "partSize",
          "isRequired": false
        },
        {
          "name": "Material",
          "storageType": "text",
          "valueMode": "Manual",
          "defaultValue": "PVC",
          "isRequired": true
        },
        {
          "name": "Installation_Date",
          "storageType": "text",
          "valueMode": "Manual",
          "defaultValue": "2026-01-01",
          "isRequired": false
        },
        {
          "name": "Design_Status",
          "storageType": "text",
          "valueMode": "Manual",
          "defaultValue": "Proposed",
          "isRequired": false
        },
        {
          "name": "Layer",
          "storageType": "text",
          "valueMode": "Rule",
          "mappingRule": "layer",
          "isRequired": false
        },
        {
